# BaitNet production environment
# ---------------------------------------------------------------------------
# On the server this lives at /etc/baitnet/env  (owner root, mode 600).
# setup-server.sh creates it from this template; edit with:
#   sudo nano /etc/baitnet/env && sudo systemctl restart baitnet
# systemd reads it (EnvironmentFile=); plain KEY=value, no quotes needed, no `export`.
# NEVER commit real values. Keys here are only ever on the server and Dylan's machine.
# ---------------------------------------------------------------------------

# ---- Server ------------------------------------------------------------------
NODE_ENV=production
# Port the Node server listens on. Caddy proxies 443 → this. Not opened in the firewall.
PORT=8787
# Bind address (only Caddy on the same host should reach the server).
# Note: needs server support for HOST; until then the firewall (22/80/443 only) protects 8787.
HOST=127.0.0.1
# Public URL people open. Used for invite links / QR codes and CORS.
# setup-server.sh fills this in (https://<your domain> or https://<ip>.sslip.io).
BAITNET_PUBLIC_URL=https://CHANGE-ME.sslip.io
# Same origin as above; the browser talks to the API on the same host (single port).
BAITNET_CORS_ORIGINS=https://CHANGE-ME.sslip.io
# Server serves the built dashboard (apps/web/dist) itself — single port, no separate web server.
# (Variable name per the backend implementation; this is the planned one.)
BAITNET_WEB_DIST=/opt/baitnet/app/apps/web/dist
# Persistent data (training.sqlite, auth DB, arena sessions, evidence, eval). Backed up daily.
BAITNET_DATA_DIR=/var/lib/baitnet

# ---- Auth (D20) --------------------------------------------------------------
# on = invite-code login, roles expert/reviewer, audit log. REQUIRED on a public server.
BAITNET_AUTH=on
# Per-user LLM calls per day (protects the NEAR AI / Claude bill).
BAITNET_LLM_DAILY_LIMIT=200
# Secret for signing session cookies (32+ random bytes). Generate: openssl rand -hex 32
# setup-server.sh generates one if empty.
BAITNET_SESSION_SECRET=

# ---- Mode / chain (D19) ------------------------------------------------------
# testnet = registry on NEAR testnet, LLM replay/rules unless keys below are set
# live    = testnet + real NEAR AI / Claude (+ Intents dry-run if LIVE_INTENTS=1)
BAITNET_MODE=live
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# The server reads $BAITNET_DATA_DIR/runtime.json for chain config; the service writes it from
# these values before every start (scripts/write-runtime.ts). Copy from Backend A's .env.testnet.
REGISTRY_CONTRACT_ID=
VAULT_CONTRACT_ID=
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=
REPORTER_ACCOUNT_ID=
REPORTER_PRIVATE_KEY=
# function-call key limited to VAULT_CONTRACT_ID / pay
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
RESPONDER1_ACCOUNT_ID=
RESPONDER1_PRIVATE_KEY=
RESPONDER1_NAME=DemoWallet
RESPONDER2_ACCOUNT_ID=
RESPONDER2_PRIVATE_KEY=
RESPONDER2_NAME=DemoExchange

# ---- LLM (D21/D28: one NEAR AI key runs everything; Claude goes via NEAR AI) ----
# Use a DIFFERENT key from your laptop's, so either can be revoked on its own.
NEARAI_API_KEY=
# Empty = deepseek-ai/DeepSeek-V4.1-Flash-1017 (TEE). Do not use the same-name deepseek/… (not TEE).
NEARAI_MODEL=
# Empty = anthropic/claude-sonnet-5-5 (via NEAR AI, Incognito, not TEE)
NEARAI_CLAUDE_MODEL=
# Optional direct Anthropic channel; leave empty to use Claude through NEAR AI
ANTHROPIC_API_KEY=
# Force one provider: nearai | claude | replay. Empty = first key available.
BAITNET_LLM=

# ---- Intents (optional) ------------------------------------------------------
LIVE_INTENTS=0
INTENTS_EXPLORER_JWT=

# ---- Evidence encryption -----------------------------------------------------
# 32-byte key (hex). setup-server.sh generates one if empty.
# LOSING IT = encrypted evidence can no longer be read. Keep a copy of this whole file in a
# password manager (it is NOT included in the daily backup on purpose).
BAITNET_EVIDENCE_KEY=

# ---- Review ------------------------------------------------------------------
# manual = reviewer must approve L1 drafts before they go on chain (default on the server)
BAITNET_REVIEW=manual
# D33 anti-confusion: look up contract / token / activity of extracted EVM & Tron addresses on public
# endpoints (3 s timeout; failure → "unchecked" warning). Override with BAITNET_EVM_RPC_URL /
# BAITNET_BSC_RPC_URL / BAITNET_TRON_API_URL ("off" skips one chain).
BAITNET_ONCHAIN_LOOKUP=on
