# BaitNet environment variables
# ---------------------------------------------------------------------------
# Copy to .env (never commit .env):   cp .env.example .env
#
# `pnpm demo` (offline, the default) needs NONE of these. Every variable below
# is optional; the "missing →" note says what happens without it.
# Variables already set in your shell take precedence over .env.
# ---------------------------------------------------------------------------

# ---- Mode ------------------------------------------------------------------
# offline | testnet | live   (CLI arg wins: `pnpm demo testnet`)
# missing → offline: local NEAR sandbox + replayed LLM + fixtures
BAITNET_MODE=offline

# ---- LLM (decoy agent, M1) -------------------------------------------------
# ONE KEY IS ENOUGH: NEARAI_API_KEY alone runs everything (decoy, arena, upload analysis,
# screenshots via Claude, zero-retention). ANTHROPIC_API_KEY is an optional direct channel.
# Provider order: NEAR AI Cloud (TEE open model) → Claude → replay (fixtures/conversations/*.json).
# Only used in `live` mode; offline/testnet always replay so output is deterministic.
# NEAR AI Cloud key from https://cloud.near.ai (OpenAI-compatible, https://cloud-api.near.ai/v1)
NEARAI_API_KEY=
# Decoy/arena model on NEAR AI. Default deepseek-ai/DeepSeek-V4.1-Flash-1017 (owned_by "nearai" = Private TEE).
# Careful: deepseek/deepseek-v4.1-flash-1017 has the same name but is NOT TEE (routed via OpenRouter).
NEARAI_MODEL=
# Claude model reached through NEAR AI (Incognito tier: NOT TEE, no attestation; never used by
# zero-retention). Used for screenshots and when BAITNET_LLM=claude. Default anthropic/claude-sonnet-5-5
NEARAI_CLAUDE_MODEL=
# D30 per-session model picker (deepseek | glm | haiku | sonnet; default deepseek). Optional id overrides,
# empty = default: NEARAI_MODEL_DEEPSEEK, NEARAI_MODEL_GLM (z-ai/glm-5.3-flash, always reasons: slow),
# NEARAI_CLAUDE_HAIKU_MODEL (anthropic/claude-haiku-5-5); direct Anthropic: CLAUDE_HAIKU_MODEL, CLAUDE_MODEL
NEARAI_MODEL_DEEPSEEK=
NEARAI_MODEL_GLM=
NEARAI_CLAUDE_HAIKU_MODEL=
# Server caches (ms): registry background refresh (default 15000, 0 = off); live attestation (default 600000)
BAITNET_REGISTRY_CACHE_MS=
BAITNET_ATTESTATION_CACHE_MS=
# Optional: call Anthropic directly instead of via NEAR AI (takes precedence for the Claude channel)
ANTHROPIC_API_KEY=
# nearai | claude | replay — force one provider in live mode. missing → first available key, else replay
BAITNET_LLM=

# ---- NEAR Intents (M6, M7) -------------------------------------------------
# 1 = request a real 1Click *dry-run* quote to show the recipient/refundTo fields
# exist in real requests (no funds move). missing/0 → fixtures/intents/quote-requests.json only
LIVE_INTENTS=0
# Intents Explorer API JWT (partners.near-intents.org), rate limit 1 req / 5 s.
# missing → fixtures/intents/explorer-transactions.json
INTENTS_EXPLORER_JWT=

# ---- Evidence encryption (M2) ----------------------------------------------
# 32-byte AES-256-GCM key, hex or base64. Generate: openssl rand -hex 32
# missing → a local key is generated on first run and stored under data/ (gitignored)
# (passed to the backend as BAITNET_EVIDENCE_KEY)
EVIDENCE_KEY=

# ---- NEAR testnet deployment (testnet / live modes only) -------------------
# The demo NEVER creates testnet accounts or deploys; it only reads these.
# missing (any required one) → `pnpm demo testnet` stops with a clear message;
# `pnpm demo live` falls back to the local sandbox chain.
# missing NEAR_RPC_URL → https://rpc.testnet.near.org
NEAR_RPC_URL=https://rpc.testnet.near.org
REGISTRY_CONTRACT_ID=
VAULT_CONTRACT_ID=
# Registry owner (add_reporter / set_status)
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=
# Whitelisted reporter (report)
REPORTER_ACCOUNT_ID=
REPORTER_PRIVATE_KEY=
# Payment agent: must be a FUNCTION-CALL key limited to VAULT_CONTRACT_ID / pay
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# Voluntary responders (register_responder / ack). RESPONDER1..4, optional
RESPONDER1_ACCOUNT_ID=
RESPONDER1_PRIVATE_KEY=
RESPONDER1_NAME=DemoWallet
RESPONDER2_ACCOUNT_ID=
RESPONDER2_PRIVATE_KEY=
RESPONDER2_NAME=DemoExchange

# ---- Local sandbox / tooling (rarely needed) -------------------------------
# Use an existing near-sandbox binary instead of downloading. missing → download once to .cache/
NEAR_SANDBOX_BIN_PATH=
# Mirror for the sandbox tarball. missing → build.nearprotocol.com (S3)
SANDBOX_ARTIFACT_URL=
# missing → 3030 (random port if busy)
NEAR_SANDBOX_RPC_PORT=
# Vault init args as JSON (sandbox only). missing → owner/agent/registry from the demo accounts,
# per_tx_limit 10 NEAR, daily_limit 50 NEAR
VAULT_INIT_ARGS=
# Backend HTTP port. missing → 8787
BAITNET_SERVER_PORT=
# Seconds to keep retrying a failing sandbox download that makes no progress. missing → 20
SANDBOX_DOWNLOAD_RETRY_SECS=
# 1 = never fall back to the in-memory registry; 0 = allow it even with --ci.
# missing → --ci requires the chain, plain `pnpm demo` falls back if the sandbox can't start
BAITNET_REQUIRE_CHAIN=
# memory = skip the local chain on purpose (in-memory registry). missing → use the chain
BAITNET_REGISTRY=
# ---- Local data (data/) ------------------------------------------------------
# Each `pnpm demo` keeps training data (training.sqlite, arena/sessions, evidence, eval,
# training-export), clears only chain-bound files, and backs up training.sqlite to
# data/backups/. Full reset: pnpm demo --fresh (backs up first, keeps evidence/.key + backups/).
# Number of training DB backups to keep. missing → 10
BAITNET_BACKUPS_KEEP=
